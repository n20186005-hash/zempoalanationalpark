{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zempoalanationalpark",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "www.zempoalanationalpark.com", "custom_domain": true }
  ],
  "vars": {
    "CURRENT_SITE_DOMAIN": "www.zempoalanationalpark.com"
  },
  "observability": {
    "enabled": true
  }
}
